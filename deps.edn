{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}

        ;; datascript: in-memory Datalog store.
        datascript/datascript {:mvn/version "1.8.1"}

        ;; hive-spi: the swarm store ports this library implements.
        io.github.hive-agi/hive-spi {:mvn/version "1.3.0"}

        ;; hive-dsl: Result/rescue. hive-di: defconfig for coordination config.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.31"}
        io.github.hive-agi/hive-di  {:mvn/version "0.4.16"}

        com.taoensso/timbre {:mvn/version "6.8.0"}
        metosin/malli {:mvn/version "0.20.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       io.github.hive-agi/hive-test {:mvn/version "0.4.9"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Clojars publishing. version = the repo's VERSION file.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
   :ns-default hive-build.api}}}
